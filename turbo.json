{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "CRON_SECRET",
        "LOGLOADS_CONTACT_EMAIL",
        "LOGLOADS_EMAIL_FROM",
        "LOGLOADS_EMAIL_REPLY_TO",
        "LOGLOADS_FEE_COLLECTION",
        "LOGLOADS_PLATFORM_ADMIN_BOOTSTRAP",
        "LOGLOADS_PLATFORM_ADMIN_BOOTSTRAP_EXPIRES_AT",
        "LOGLOADS_PLATFORM_ADMIN_CLERK_IDS",
        "LOGLOADS_PLATFORM_ADMIN_EXPECTED_SCOPE_SHA256",
        "LOGLOADS_STRIPE_EXPECTED_ACCOUNT_ID",
        "LOGLOADS_STRIPE_EXPECTED_LIVEMODE",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "RESEND_API_KEY",
        "RESEND_FROM",
        "RESEND_REPLY_TO",
        "STRIPE_PUBLISHABLE_KEY",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "SUPPORT_EMAIL",
        "VERCEL_URL"
      ],
      "outputs": []
    },
    "@logloads/web#build": {
      "dependsOn": ["^build"],
      "env": [
        "CRON_SECRET",
        "LOGLOADS_CONTACT_EMAIL",
        "LOGLOADS_EMAIL_FROM",
        "LOGLOADS_EMAIL_REPLY_TO",
        "LOGLOADS_FEE_COLLECTION",
        "LOGLOADS_PLATFORM_ADMIN_BOOTSTRAP",
        "LOGLOADS_PLATFORM_ADMIN_BOOTSTRAP_EXPIRES_AT",
        "LOGLOADS_PLATFORM_ADMIN_CLERK_IDS",
        "LOGLOADS_PLATFORM_ADMIN_EXPECTED_SCOPE_SHA256",
        "LOGLOADS_STRIPE_EXPECTED_ACCOUNT_ID",
        "LOGLOADS_STRIPE_EXPECTED_LIVEMODE",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "RESEND_API_KEY",
        "RESEND_FROM",
        "RESEND_REPLY_TO",
        "STRIPE_PUBLISHABLE_KEY",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "SUPPORT_EMAIL",
        "VERCEL_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "test": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
