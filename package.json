{
  "name": "logloads",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": "24.16.0"
  },
  "scripts": {
    "build": "turbo run build",
    "db:check": "bash ./tools/db-check.sh",
    "dev": "pnpm --filter @logloads/web dev",
    "lint": "turbo run lint && pnpm lint:workflows",
    "lint:workflows": "npx --yes github-actionlint@1.7.12",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "eslint": "^8.57.1",
    "turbo": "^2.5.4",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
