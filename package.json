{
  "name": "logloads",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "core-js",
      "sharp"
    ],
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "baseline-browser-mapping": "2.11.28",
      "brace-expansion@1.1.15": "1.1.18",
      "brace-expansion@>=3.0.0": "5.0.12",
      "browserslist": "4.29.3",
      "dompurify": "3.4.16",
      "esbuild": "0.28.1",
      "fast-uri@3": "3.1.8",
      "fflate@0.4": "0.4.9",
      "js-yaml@4.2.0": "4.3.1",
      "nanoid@3": "3.3.20",
      "postcss": "8.5.23",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "db:assert": "bash ./tools/db-check.sh",
    "db:check": "bash ./tools/db-check.sh",
    "deadcode": "knip",
    "demo": "node tools/founder-demo.mjs",
    "demo:capture-pilot": "node tools/capture-pilot-surfaces.mjs",
    "dev": "pnpm --filter @logloads/web dev",
    "guardrails": "node tools/check-guardrails.mjs",
    "lint": "turbo run lint && pnpm lint:workflows",
    "lint:workflows": "npx --yes github-actionlint@1.7.12",
    "screenshot": "node tools/screenshot.mjs",
    "smoke": "node tools/production-smoke.mjs",
    "state:backup": "node tools/operating-state-backup.mjs",
    "test": "turbo run test --concurrency=1 && pnpm test:tools",
    "test:e2e": "node tools/run-e2e.mjs",
    "test:tools": "node --test tools/*.test.mjs",
    "typecheck": "turbo run typecheck",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm db:assert && pnpm guardrails && pnpm deadcode"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.61.1",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "eslint": "^8.57.1",
    "knip": "5.88.1",
    "turbo": "^2.5.4",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
