# LogLoads — environment variable manifest (NAMES ONLY, NO VALUES)
#
# Source of truth for VALUES is Doppler (project `logloads`, configs dev / stg / prd).
# stg syncs to Vercel Preview and prd to Vercel Production. Never paste real secrets
# here or commit a real .env:
#   doppler setup                     # once per checkout
#   doppler run --config dev -- pnpm dev
#
# .env* is git-ignored. This .env.example is the ONLY env file in the repo.
# Machine-readable contract: ops/production-env-contract.json. Fresh-start runbook:
# docs/INTEGRATIONS.md. Check any environment without printing values:
#   doppler run --config stg -- pnpm integrations:check --target staging
#
# Every name below has a code reader or a named external reader
# (tools/integration-readiness-contract.test.mjs enforces this).

# --- App ---
# Local dev runs on port 3002; `pnpm setup:local` writes this into apps/web/.env.local.
NEXT_PUBLIC_APP_URL=http://localhost:3002
CRON_SECRET=
# Sole current commercial collection gate for percentage_v1 platform-fee
# invoices and any preserved legacy_percentage obligation. Keep disabled until
# an exact, explicitly authorized live-money activation.
LOGLOADS_FEE_COLLECTION=disabled
# Separate legal/pilot enrollment gate. Keep disabled and the exact
# organization allowlist blank until the dated operating posture is approved.
# Enabling fee collection never enrolls a host, and enabling enrollment never
# authorizes a provider charge.
LOGLOADS_PERCENTAGE_ENROLLMENT=disabled
LOGLOADS_PERCENTAGE_ALLOWED_ORGANIZATION_IDS=
# Required only for enabled enrollment. SHA-256 of the sorted, normalized exact
# organization-id scope; keep private and blank while enrollment is dark.
LOGLOADS_PERCENTAGE_EXPECTED_ORGANIZATION_SCOPE_SHA256=
# Historical subscription_v1 safety gate. It must remain disabled: historical
# provider obligations may reconcile, but this gate does not authorize new
# subscription enrollment or usage collection.
LOGLOADS_SUBSCRIPTION_COLLECTION=disabled
# Historical subscription canary allowlist. Leave blank; no new organization
# may enter subscription_v1 under the 2026-08-01 percentage_v1 decision.
LOGLOADS_SUBSCRIPTION_ALLOWED_ORGANIZATION_IDS=
# Historical Dispatch Pro self-serve gate. It must remain disabled.
LOGLOADS_DISPATCH_SELF_SERVE=disabled
# Owner-only nominal provider verification. Both values are required; leave the
# gate disabled until the exact founder user id is approved for one manual run.
LOGLOADS_INTERNAL_BILLING_SMOKE=disabled
LOGLOADS_INTERNAL_BILLING_SMOKE_ALLOWED_USER_IDS=
LOGLOADS_INTERNAL_BILLING_SMOKE_ALLOWED_ORGANIZATION_IDS=

# --- Marketplace V2 preview (/v2) ---
# Exactly "enabled" turns on the flagged V2 load board. MUST be unset in Production
# (the code also ignores it when VERCEL_ENV=production). Allowed in dev, and in stg
# only with an isolated Supabase project (docs/DEPLOYMENT.md §4).
LOGLOADS_MARKETPLACE_V2=
# Store behind /v2: pilot (default) or normalized. normalized needs the three
# LOGLOADS_NORMALIZED_* values (docs/SECURITY.md §4.1). MUST be unset in Production;
# stg only for the staging normalized-V2 proof. The database URL is a secret.
LOGLOADS_MARKETPLACE_V2_ADAPTER=
LOGLOADS_NORMALIZED_DATABASE_URL=
LOGLOADS_NORMALIZED_IDENTITY_ISSUER=
LOGLOADS_NORMALIZED_IDENTITY_AUDIENCE=

# --- Supabase (database / storage — Postgres + PostGIS for regions/geolocation; auth is Clerk) ---
# tools/provision-supabase-project.mjs writes these into a Doppler config.
SUPABASE_URL=
# Legacy service_role JWT. Server-only: never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Preferred browser key for private-media signed uploads.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibility alias for projects still using the legacy key name. The
# publishable-key value above is authoritative if both names are present.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Read only by the unused getSupabaseServerEnv helper in packages/db; not provisioned.
SUPABASE_ANON_KEY=
# Tooling only (the app never reads them): migrations and project identity.
# DATABASE_URL uses the session pooler on port 5432 (IPv4).
DATABASE_URL=postgresql://USER:PASS@localhost:55322/DATABASE
SUPABASE_PROJECT_REF=your-logloads-project-ref
SUPABASE_DB_PASSWORD=
# Account-wide management token for tools/provision-supabase-project.mjs only.
# MUST NOT live in stg or prd (they sync to Vercel); revoke it after provisioning.
SUPABASE_ACCESS_TOKEN=

# --- Private media (credential documents, equipment photos, trip proof) ---
# Supabase Storage is the only supported media provider. The bucket must remain
# private; the server issues one-object upload tokens and short-lived read URLs.
# Create or verify it with: node tools/supabase-post-provision.mjs bucket --apply
LOGLOADS_MEDIA_STORAGE=supabase
LOGLOADS_MEDIA_BUCKET=logloads-private-media
LOGLOADS_SUPABASE_EXPECTED_PROJECT_REF=your-logloads-project-ref

# --- Clerk (AUTH — cross-app standard, locked 2026-06-04) ---
# pk_test_/sk_test_ from the development instance for dev and stg; pk_live_/sk_live_
# from the production instance for prd only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Read by @clerk/nextjs, not LogLoads code: keep Clerk's own links on the app's pages.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
# Persistent platform-admin scope. Production authority requires exactly one
# real Clerk user_ id and the exact lowercase SHA-256 of:
#   logloads-platform-admin-scope-v1\n<that Clerk user id>
# Keep both values server-only. The seed placeholder is never valid with Clerk.
LOGLOADS_PLATFORM_ADMIN_CLERK_IDS=
LOGLOADS_PLATFORM_ADMIN_EXPECTED_SCOPE_SHA256=
# Temporary one-time claim window. Enable only with a strict future ISO instant,
# claim at /admin/bootstrap, then disable the gate and remove the expiry.
LOGLOADS_PLATFORM_ADMIN_BOOTSTRAP=disabled
LOGLOADS_PLATFORM_ADMIN_BOOTSTRAP_EXPIRES_AT=

# --- LogLoads sessions (cookie signing + dev sign-in; see docs/ENVIRONMENT.md) ---
LOGLOADS_SESSION_SECRET=
# Development and test switches. MUST be unset on every hosted deployment.
LOGLOADS_ENABLE_DEV_LOGIN=
LOGLOADS_DEMO_MODE=
LOGLOADS_STATE_FILE=
# One controlled bootstrap of an intentionally empty canonical operating_state row
# (docs/INTEGRATIONS.md §2.5). Remove it immediately afterwards.
LOGLOADS_ALLOW_STATE_BOOTSTRAP=

# --- Distributed abuse controls (shared Supabase Postgres RPC) ---
# Production reuses SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above. No separate
# KV/Redis provider is required for the current fixed-window workload.
# Required in every environment (local development included: `pnpm setup:local`
# generates a local-only value). Raw client identifiers are never stored in
# the shared limiter; rotating this key resets the active pseudonymous buckets.
LOGLOADS_RATE_LIMIT_HMAC_SECRET=
LOGLOADS_RATE_LIMIT_KEY_PREFIX=logloads:rate-limit
# Test harness only. Never set in Preview or Production.
LOGLOADS_RATE_LIMIT_TEST_MODE=

# --- LogLoads outbound email + contact routing (Resend-gated) ---
LOGLOADS_CONTACT_EMAIL=
LOGLOADS_EMAIL_FROM=
LOGLOADS_EMAIL_REPLY_TO=

# --- Historical Stripe subscription catalog (read-only reconciliation) ---
# These names remain because released code and any previously accepted provider
# obligation may reference them. Do not provision or use them for new enrollment;
# a fresh Stripe account has nothing to reconcile, so leave them unset.
STRIPE_PRICE_DISPATCH=
STRIPE_PRICE_NETWORK_PILOT=
STRIPE_PRICE_NETWORK_PILOT_OVERAGE=
STRIPE_PRICE_NETWORK_25=
STRIPE_PRICE_NETWORK_25_OVERAGE=
STRIPE_PRICE_NETWORK_50=
STRIPE_PRICE_NETWORK_50_OVERAGE=
STRIPE_PRICE_NETWORK_100=
STRIPE_PRICE_NETWORK_100_OVERAGE=
# Dedicated portal configuration: payment-method updates and invoice history only.
# Self-service cancellation and plan changes must both be disabled. Commitment
# non-renewal stays canonical, sales-assisted, and scheduled by LogLoads.
STRIPE_PORTAL_CONFIGURATION_NETWORK=
# Hidden one-time $1 Price. It is never an entitlement or ordinary revenue item.
STRIPE_PRICE_INTERNAL_BILLING_TEST=

# --- Stripe (current platform-fee invoices + historical subscription reconciliation) ---
# Stripe never receives or distributes carrier/driver transportation
# compensation. The pricing or payment rail does not determine LogLoads'
# regulatory classification. Stripe Connect remains intentionally out of scope.
STRIPE_SECRET_KEY=
# Independent mode assertion. Production must be live; local/test environments
# must say test. A test key cannot satisfy a live runtime and vice versa.
LOGLOADS_STRIPE_EXPECTED_LIVEMODE=test
# Required server-side tenancy assertion. Runtime money routes and activation
# tools call GET /v1/account and refuse any key whose account does not match.
LOGLOADS_STRIPE_EXPECTED_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=
# Existing server-side name is returned only from the authenticated SetupIntent
# route. NEXT_PUBLIC_ is also accepted when a deployment prefers that convention.
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- PostHog (product analytics; set NEXT_PUBLIC_POSTHOG_KEY to activate) ---
# Project key (phc_), never a personal API key. Delete the host rather than blank it.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry (server error monitoring; set SENTRY_DSN to activate) ---
# Source maps are not uploaded (no withSentryConfig), so no Sentry auth token is read.
SENTRY_DSN=

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
SUPPORT_EMAIL=

# --- Maps ---
# Preferred: MapLibre with authenticated CARTO Basemaps. The key is browser-visible, so restrict it by
# origin in CARTO, and keep separate dev and prod keys. Absent: legacy Mapbox if its token is set,
# otherwise keyless CARTO. The CARTO allowance is unverified; it requires account verification (#114).
NEXT_PUBLIC_CARTO_BASEMAP_KEY=
# Legacy Mapbox public token (pk.), used only when no CARTO key is set.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- AI credential review (legacy pilot: REQUIRED before any driver can accept work) ---
ANTHROPIC_API_KEY=
CREDENTIAL_REVIEW_MODEL=claude-opus-5
# Optional assistant rephrasing model (only used when ANTHROPIC_API_KEY is set).
ASSISTANT_MODEL=

# --- Operator tooling (never needed by the running app) ---
# Doppler service token for non-interactive CI/servers; a developer uses `doppler login`.
DOPPLER_TOKEN=
# CLI locations when the CLIs are not on PATH.
DOPPLER_CLI=
SUPABASE_CLI=
# Vercel Protection Bypass for Automation, for `pnpm integrations:check --health-url` on a protected Preview.
VERCEL_AUTOMATION_BYPASS_SECRET=
# DEV-ONLY: development Supabase project refs and two development-instance Clerk test
# user ids for tools/verify-clerk-supabase-auth.mjs (#112). Doppler dev only.
LOGLOADS_SUPABASE_DEV_PROJECT_REFS=
LOGLOADS_AUTH_HARNESS_CLERK_USER_IDS=

# --- PR agent dispatch webhooks (GitHub Actions repository secrets read by .github/workflows/pr-agent-dispatch.yml) ---
# Set them in GitHub, never in Doppler or Vercel.
CODEX_AGENT_WEBHOOK_URL=
CODEX_AGENT_WEBHOOK_TOKEN=
CLAUDE_AGENT_WEBHOOK_URL=
CLAUDE_AGENT_WEBHOOK_TOKEN=
SENTRY_AGENT_WEBHOOK_URL=
SENTRY_AGENT_WEBHOOK_TOKEN=
GIT_AGENT_WEBHOOK_URL=
GIT_AGENT_WEBHOOK_TOKEN=
